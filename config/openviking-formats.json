  "image": [".png", ".jpg", ".jpeg", ".gif", ".bmp", ".webp", ".svg", ".tiff", ".tif", ".ico", ".dib", ".icns", ".sgi", ".jp2"],
  "audio": [".mp3", ".wav", ".ogg", ".flac", ".aac", ".m4a", ".opus", ".ac3"],
